{
  "name": "@mailts/trap",
  "version": "0.1.2",
  "description": "Local SMTP mail trap with web preview UI — zero-signup Ethereal replacement",
  "license": "MIT",
  "author": {
    "name": "Anish Shekh",
    "url": "https://github.com/anishhs-gh"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mailts-trap": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test"
  },
  "devDependencies": {
    "@mailts/core": "file:../..",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "mailts",
    "email",
    "smtp",
    "trap",
    "mail-trap",
    "preview",
    "development",
    "ethereal",
    "mailhog",
    "mailtrap",
    "local-smtp",
    "email-testing",
    "web-ui",
    "devtools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/anishhs-gh/mailts",
    "directory": "packages/trap"
  }
}
