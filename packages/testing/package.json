{
  "name": "@mailts/testing",
  "version": "0.1.0",
  "description": "Vitest/Jest helpers for testing email sending with @mailts/trap",
  "license": "MIT",
  "author": {
    "name": "Anish Shekh",
    "url": "https://github.com/anishhs-gh"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "@mailts/trap": ">=0.1.0 <2.0.0"
  },
  "peerDependencies": {
    "@mailts/core": ">=0.1.0 <2.0.0"
  },
  "peerDependenciesMeta": {
    "@mailts/core": {
      "optional": false
    }
  },
  "devDependencies": {
    "@mailts/core": "file:../..",
    "@mailts/trap": "file:../trap",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "mailts",
    "email",
    "testing",
    "vitest",
    "jest",
    "trap",
    "email-testing",
    "mail-trap",
    "test-helpers",
    "smtp",
    "integration-testing"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/anishhs-gh/mailts",
    "directory": "packages/testing"
  }
}
