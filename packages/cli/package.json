{
  "name": "@mailts/cli",
  "version": "0.1.4",
  "description": "Command-line interface for mailts — configure, test, send, read, queue",
  "license": "MIT",
  "author": {
    "name": "Anish Shekh",
    "url": "https://github.com/anishhs-gh"
  },
