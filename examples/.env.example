# Copy to examples/.env (gitignored) and fill in what you have.
# Used by: npm run example:oauth-web

# Google — "Desktop app" works for local testing; "Web application" for deployments
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft — Entra app registration (optional)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common

# Where the app is reachable; redirect URI = BASE_URL/callback.
# On a Web application client, add this URI under "Authorized redirect URIs"
# (e.g. http://127.0.0.1:3000/callback). If it isn't registered, Google returns
# "Error 400: redirect_uri_mismatch". Matching is exact, so use the same host and port as BASE_URL.
BASE_URL=http://127.0.0.1:3000
